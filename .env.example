# ============================================================
# CartSense — Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=cartsense_user
POSTGRES_PASSWORD=cartsense_pass
POSTGRES_DB=cartsense
DATABASE_URL=postgresql+psycopg2://cartsense_user:cartsense_pass@postgres_db:5432/cartsense

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow_server:5000
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://cartsense_user:cartsense_pass@postgres_db:5432/cartsense
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Model Names in MLflow Registry ---
TFIDF_MODEL_NAME=CartSense_TFIDF
ALS_MODEL_NAME=CartSense_ALS

# --- Hybrid Scoring Weights ---
# alpha: weight for ALS collaborative score (0-1)
ALPHA=0.65
# beta: weight for specification matching boost
BETA=0.20

# --- Recommendation ---
TOP_K=5

# --- ALS Hyperparameters ---
ALS_RANK=20
ALS_MAX_ITER=15
ALS_REG_PARAM=0.1
ALS_SEED=42

# --- Drift Detection ---
# Fraction of features that must drift to trigger retraining (0-1)
DRIFT_THRESHOLD=0.5

# --- Artifact Storage ---
ARTIFACTS_DIR=/app/artifacts

# --- Streamlit ---
BACKEND_URL=http://fastapi_backend:8000
